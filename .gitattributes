# Committed with LF regardless of the checkout platform. Shell scripts and CI
# workflows run on Linux; a CRLF deploy.sh fails with "bad interpreter: ^M".
* text=auto eol=lf
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.sql  text eol=lf
Dockerfile* text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.wav binary
