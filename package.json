{
  "name": "gamingpro-games",
  "type": "module",
  "version": "1.3.15",
  "description": "A fresh and elegant admin template, based on Vue3、Vite7、NaiveUI and UnoCSS.",
  "keywords": [
    "Vue3 admin ",
    "vue-admin-template",
    "Vite7",
    "naive-ui",
    "naive-ui-admin",
    "ant-design-vue v4",
    "UnoCSS"
  ],
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.5.0"
  },
  "scripts": {
    "build": "vite build --mode prod",
    "build:test": "vite build --mode test",
    "cleanup": "sa cleanup",
    "commit": "sa git-commit",
    "commit:zh": "sa git-commit -l=zh-cn",
    "dev": "vite --mode test",
    "dev:prod": "vite --mode prod",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen-route": "sa gen-route",
    "lint": "eslint . --fix",
    "prepare": "echo 'Git hooks disabled'",
    "preview": "vite preview",
    "release": "sa release",
    "update-pkg": "sa update-pkg"
  },
  "dependencies": {
    "@better-scroll/core": "2.5.1",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@iconify/vue": "5.0.0",
    "@sa/axios": "workspace:*",
    "@sa/color": "workspace:*",
    "@sa/hooks": "workspace:*",
    "@sa/materials": "workspace:*",
    "@sa/utils": "workspace:*",
    "@tiptap/core": "^3.19.0",
    "@tiptap/extension-link": "^3.19.0",
    "@tiptap/extension-table": "^3.19.0",
    "@tiptap/extension-underline": "^3.19.0",
    "@tiptap/starter-kit": "^3.19.0",
    "@tiptap/vue-3": "^3.19.0",
    "@tsparticles/slim": "^3.9.1",
    "@tsparticles/vue3": "^3.0.1",
    "@vicons/ionicons5": "^0.13.0",
    "@vueup/vue-quill": "^1.2.0",
    "@vueuse/core": "13.9.0",
    "clipboard": "2.0.11",
    "dayjs": "1.11.18",
    "defu": "6.1.4",
    "echarts": "6.0.0",
    "json5": "2.2.3",
    "naive-ui": "2.43.1",
    "nprogress": "0.2.0",
    "pinia": "3.0.3",
    "quill": "^2.0.3",
    "tailwind-merge": "3.3.1",
    "vue": "3.5.21",
    "vue-draggable-plus": "0.6.0",
    "vue-i18n": "11.1.12",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@elegant-router/vue": "0.3.8",
    "@iconify/json": "2.2.385",
    "@sa/scripts": "workspace:*",
    "@sa/uno-preset": "workspace:*",
    "@soybeanjs/cli": "^1.4.1",
    "@soybeanjs/eslint-config": "1.7.1",
    "@unocss/eslint-config": "66.5.1",
    "@unocss/preset-icons": "66.5.1",
    "@unocss/preset-uno": "66.5.1",
    "@unocss/transformer-directives": "66.5.1",
    "@unocss/transformer-variant-group": "66.5.1",
    "@unocss/vite": "66.5.1",
    "@vitejs/plugin-vue": "6.0.1",
    "@vitejs/plugin-vue-jsx": "5.1.1",
    "consola": "3.4.2",
    "eslint": "9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "10.4.0",
    "kolorist": "1.8.0",
    "prettier": "^3.6.2",
    "sass": "1.92.1",
    "simple-git-hooks": "2.13.1",
